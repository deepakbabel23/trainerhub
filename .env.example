# Copy to .env for local use, or set these in your host's dashboard.
# Only TRAINERHUB_ADMIN_PASSWORD is required in production.

NODE_ENV=production
TRAINERHUB_ADMIN_EMAIL=you@yourdomain.com
TRAINERHUB_ADMIN_PASSWORD=change-me-to-something-private

# Optional
# TRAINERHUB_DEMO=on           # expose reset/fill/clear routes (off in production by default)
# TRAINERHUB_DATA_DIR=/data    # persistent disk mount path
# TRAINERHUB_SECURE_COOKIES=0  # only if you are deliberately serving over plain HTTP
